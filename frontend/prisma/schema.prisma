// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  baseResume    Json?          // Stores the parsed base ResumeProfile
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  applications  Application[]
}

model JobOpportunity {
  id             String        @id @default(uuid())
  title          String
  company        String
  location       String?
  salary         String?
  url            String?
  source         String        // e.g., Naukri, RemoteOK, Wellfound
  scrapedAt      DateTime      @default(now())
  description    String?       // The raw JD text
  parsedJD       Json?         // The JobDescriptionProfile JSON
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  applications   Application[]
}

model Application {
  id             String          @id @default(uuid())
  userId         String
  jobId          String
  status         String          @default("DISCOVERED") // DISCOVERED, TAILORING, OUTREACH_SENT, INTERVIEW, REJECTED
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  job            JobOpportunity  @relation(fields: [jobId], references: [id])
  tailoredResume TailoredResume?
  outreachLog    OutreachLog?
}

model TailoredResume {
  id             String          @id @default(uuid())
  applicationId  String          @unique
  tailoredContent Json           // TailoredResumeSchema JSON
  matchScore     Json?           // MatchScoreSchema JSON
  gapAnalysis    Json?           // GapAnalysisSchema JSON
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  application    Application     @relation(fields: [applicationId], references: [id])
}

model OutreachLog {
  id             String          @id @default(uuid())
  applicationId  String          @unique
  subject        String
  body           String
  status         String          // DRAFTED, SENT, FAILED, SKIPPED
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  application    Application     @relation(fields: [applicationId], references: [id])
}
